{
  "manifest_version": 3,
  "name": "Career Hub 一鍵匯入",
  "version": "1.0",
  "description": "在 LinkedIn / Handshake 職缺頁一鍵抓取 JD、AI 分析並匯入 Career Hub Job Tracker",
  "action": {
    "default_popup": "popup.html",
    "default_title": "分析並匯入 Career Hub"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "notifications"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.joinhandshake.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
