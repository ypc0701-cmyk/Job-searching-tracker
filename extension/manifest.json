{
  "manifest_version": 3,
  "name": "Career Hub 一鍵匯入",
  "version": "1.0",
  "description": "在 LinkedIn / Handshake / Indeed 職缺頁一鍵抓取 JD、AI 分析並匯入 Career Hub Job Tracker",
  "action": {
    "default_popup": "popup.html",
    "default_title": "分析並匯入 Career Hub"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.joinhandshake.com/*",
    "https://*.indeed.com/*",
    "https://ypc0701-cmyk.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://ypc0701-cmyk.github.io/Job-searching-tracker/*"],
      "js": ["content-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
